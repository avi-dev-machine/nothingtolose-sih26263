# ==============================================================================
# APAARSetu: Environment Configuration Example
# ==============================================================================

# Backend Configuration
SECRET_KEY=apaarsetu-dev-secret-key-32-chars-long-secure-random
HMAC_SALT_KEY=apaarsetu-hmac-salt-key-secure-2026
DATABASE_URL=sqlite:///./apaarsetu.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apaarsetu

ENVIRONMENT=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
